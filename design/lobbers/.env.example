# Client only — there is no server. Copy to apps/client/.env.local for local overrides; set on Vercel for production.

# WebRTC ICE servers (JSON). Default = Google STUN. Add a TURN server if some players can't connect
# (strict NAT / some mobile data networks), e.g.:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS=

# Signaling. Leave VITE_PEER_HOST empty to use the free PeerJS cloud server.
# Local / tests: npm run peer:local, then:
# VITE_PEER_HOST=localhost
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=false
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_SECURE=
VITE_PEER_KEY=
